{
  "expo": {
    "name": "Kanki - Günün Sözleri",
    "slug": "kankiv2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kanki",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kanki.quotes",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification",
          "processing"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07070F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.kanki.quotes",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-font",
      "expo-splash-screen",
      "expo-background-task",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C4B5FD"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Paylaşım kartı için kendi fotoğraflarınızı seçmenize olanak tanır."
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.kanki.quotes",
          "widgets": [
            {
              "name": "KankiQuote",
              "displayName": "Kanki - Günün Sözü",
              "description": "Kilit ekranında ve ana ekranda günün ilham verici sözleri",
              "ios": {
                "supportedFamilies": [
                  "accessoryRectangular",
                  "accessoryInline",
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "KankiQuote",
              "label": "Kanki - Günün Sözü",
              "description": "Kilit ekranı ve ana sayfada günün ilham verici sözleri",
              "minWidth": "320dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ]
  }
}
