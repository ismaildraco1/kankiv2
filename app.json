{
  "expo": {
    "name": "Kanki",
    "slug": "kankiv2",
    "version": "1.1.0",
    "description": "Günün ilham veren sözleri, motivasyon bildirimleri ve estetik kilit ekranı widget'ı.",
    "primaryColor": "#FF8A6B",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kanki",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kanki.quotes",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification",
          "processing"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "GADApplicationIdentifier": "ca-app-pub-9488860514529599~1287950257",
        "NSUserTrackingUsageDescription": "Bu izin, size daha ilgili ve kaliteli reklamlar sunabilmek için kullanılır.",
        "SKAdNetworkItems": [
          {
            "SKAdNetworkIdentifier": "cstr6suwn9.skadnetwork"
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.kanki.quotes",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-font",
      "expo-splash-screen",
      "expo-background-task",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FFB59E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Paylaşım kartı için kendi fotoğraflarınızı seçmenize olanak tanır."
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.kanki.quotes",
          "widgets": [
            {
              "name": "KankiQuote",
              "displayName": "Kanki - Günün Sözü",
              "description": "Kilit ekranında ve ana ekranda günün ilham verici sözleri",
              "ios": {
                "supportedFamilies": [
                  "accessoryRectangular",
                  "accessoryInline",
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "KankiQuote",
              "label": "Kanki - Günün Sözü",
              "description": "Kilit ekranı ve ana sayfada günün ilham verici sözleri",
              "minWidth": "320dp",
              "minHeight": "155dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "minResizeWidth": "250dp",
              "minResizeHeight": "110dp",
              "maxResizeWidth": "540dp",
              "maxResizeHeight": "420dp",
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen|keyguard",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9488860514529599~1287950257",
          "iosAppId": "ca-app-pub-9488860514529599~1287950257",
          "delayAppMeasurementInit": false,
          "userTrackingUsageDescription": "Bu izin, size daha ilgili ve kaliteli reklamlar sunabilmek için kullanılır."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.kanki.quotes.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.kanki.quotes"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "e98ce194-4f68-4f77-b48b-c519cd245988"
      }
    }
  }
}